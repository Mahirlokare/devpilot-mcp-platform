# ============================================================
# DevPilot Root Environment Configuration (.env.example)
# Copy to `backend/.env` or root `.env` and populate values.
# Never commit real API keys or secrets to version control.
# ============================================================

# Environment: development | production | test
DEVPILOT_ENVIRONMENT=development

# Database connection (SQLite for local dev, PostgreSQL / Supabase for prod)
DEVPILOT_DATABASE_URL=sqlite+aiosqlite:///./devpilot.db
# Example PostgreSQL / Supabase:
# DEVPILOT_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/devpilot

# Security secrets (REQUIRED in production; auto-generated in development if blank)
# Generate JWT secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
DEVPILOT_JWT_SECRET=
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEVPILOT_ENCRYPTION_KEY=

# Allow registration after initial admin account creation
DEVPILOT_ALLOW_REGISTRATION=false

# Allowed CORS origins (JSON list or comma-separated)
DEVPILOT_CORS_ORIGINS=["http://localhost:5173"]

# OpenAI API configuration (for LLM orchestration)
DEVPILOT_OPENAI_API_KEY=
DEVPILOT_OPENAI_MODEL=gpt-4o

# GitHub OAuth & MCP integration
DEVPILOT_GITHUB_CLIENT_ID=
DEVPILOT_GITHUB_CLIENT_SECRET=
DEVPILOT_GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback
DEVPILOT_FRONTEND_URL=http://localhost:5173
GITHUB_TOKEN=

# Default workspace jail for filesystem, terminal, and testing MCP servers
DEVPILOT_WORKSPACE_ROOT=./workspace

# Target project database inspected by the read-only Database MCP server
DEVPILOT_PROJECT_DB_URL=sqlite:///./workspace/sample.db

# Terminal sandbox mode: process (local dev) | docker (production)
DEVPILOT_TERMINAL_SANDBOX=process

# Deployment MCP providers (optional)
RENDER_API_KEY=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
